# ==============================================================================
# JIRA CONFIGURATION TEMPLATE
# Copy file này thành .env.jira (file này đã được .gitignore bảo vệ, không bao giờ bị commit)
# ==============================================================================

# 1. URL của Jira (không có dấu / ở cuối)
# Ví dụ Server/Data Center: https://jira.yourcompany.com
# Ví dụ Cloud:              https://your-domain.atlassian.net
JIRA_BASE_URL=https://jira.yourcompany.com

# 2. Loại Jira: "server" (Data Center on-premise) hoặc "cloud"
JIRA_TYPE=server

# 3. Token chứng thực:
# - Nếu là Server/Data Center: Điền Personal Access Token (PAT) tạo từ Jira Profile -> Personal Access Tokens
# - Nếu là Cloud: Điền API Token tạo từ https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=your_pat_or_api_token_here

# 4. Email (CHỈ BẮT BUỘC KHI JIRA_TYPE=cloud):
JIRA_EMAIL=your_email@company.com
