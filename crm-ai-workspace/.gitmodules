# Điền URL/branch thật của từng microservice.
# .gitmodules chỉ khai báo nguồn + branch mặc định, KHÔNG ghim commit.
[submodule "src/customer"]
	path = src/customer
	url = https://github.com/qhuyns003/MicroAI-customer
	branch = main
[submodule "src/identity"]
	path = src/identity
	url = https://github.com/qhuyns003/MicroAI-identity
	branch = main
[submodule "src/gateway"]
	path = src/gateway
	url = https://github.com/qhuyns003/MicroAI-gateway
	branch = main